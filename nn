import numpy as np
import matplotlib.pyplot as plt

def tanh(X, Hadamard = False):
	
	if Hadamard:
		for x in range(len(X)):
			X[x] = np.tanh(X[x])
	else:
		X = np.tanh(X)
		
	return X


def ReLU(X, Hadamard = False):

	if Hadamard:
		if all(X) >= 0:
			return X

		elif all(X) < 0:
			return np.zeros(X.shape())
	
		else:
			for x in range(len(X)):
				if X[x] < 0: 
					X[x] = 0
	else:
		if X < 0:
			X = 0

	return X

def Sig(X, Hadamard = False):

	if Hadamard:
		for x in range(len(X)):
			X[x] = 1/ (1 + np.exp(-1*X[x]))

	else:
		X = 1/ (1 + np.exp(-1*X))

	return X
class NeuralNetwork:
	#"Layers" is the dimensions of the network
	#NeuralNetwork.nn contains the weights and biases
	def __init__(self, Layers, ActivisionFunction = [None]):
		self.Layers = Layers
		self.nn = []
		self.ActivisionFunction = ActivisionFunction

		self.DataMean = None
		self.DataStd = None

		for l in range(len(self.Layers)-1):

			NextLayer = self.Layers[l+1]

			weights = np.random.uniform(-1, 1, size=(NextLayer, self.Layers[l]))
			biases = np.random.uniform(-1, 1, size=NextLayer)

			self.nn.append([weights, biases])

	def Run(self, Inputs, ReturnAnZ = False):

		Inputs = (Inputs - self.DataMean)/self.DataStd #Normalization

		A = [Inputs]
		Z = []
    
		LayerActivision = Inputs

		for l in range(len(self.nn)):
			
			LayerActivision = np.matmul(self.nn[l][0], LayerActivision) + self.nn[l][1]

			Z.append(LayerActivision)

			if self.ActivisionFunction[l + 1]:	
				match self.ActivisionFunction[0]:
					case "ReLU":
						LayerActivision = ReLU(LayerActivision, True)
					case "Sig":
						LayerActivision = Sig(LayerActivision, True)
					case "tanh":
						LayerActivision = tanh(LayerActivision, True)


			A.append(LayerActivision)
		A.pop(-1)

		LayerActivision = LayerActivision * self.DataStd + self.DataMean #Denormalization

		#A contains the activisions of all nodes except output
		#Z contains all the weighted sums before the activision function
		if ReturnAnZ:
			return(LayerActivision, A, Z)
		else:
			return(LayerActivision) 

	def Optimize(self, X, Y, LearningRate = 0.0003, epochs = 150):

		self.DataMean = np.mean(X, axis=0)
		self.DataStd = np.std(X, axis=0)
		
		for epoch in range(epochs):
			
			if epoch % 100 == 0 and epoch != 0:
				print(self.nn)

			for x,y in zip(X,Y):

				P, A, Z = self.Run(x, True)
				El = None
				#backpropagation algorithm
				LayerIndex = len(self.nn) - 1
				FirstLayer = True
				while 0 <= LayerIndex:

					if FirstLayer:
						#El= Ea ⊙ f′(zL), where l is the last layer and Ea is a vector of the dEda of l
						El = -2 * (y - P)

					else:
						#the equation for the rate of change of Error relative to the activisions of a layer.
						#El = ((Wl+1)T x El+1) ⊙ f′(zl)		
						El = np.matmul(self.nn[LayerIndex + 1][0].transpose(), El)

					if self.ActivisionFunction[LayerIndex + 1]:	
						match self.ActivisionFunction[0]:
						#Multiply El by the derivative of f in respect to the weighted sums of the layer l.
							case "ReLU":
								dfdZl = []
								for z in Z[LayerIndex]:
									if z < 0:
										dfdZl.append(0)
									else:
										dfdZl.append(1)

								El = El * dfdZl

							case "Sig":
								dfdZl = []
								if not FirstLayer:
									for a in A[LayerIndex]:
										dfdZl.append(a * (1-a))
								else:
									for a in P:
										dfdZl.append(a * (1-a))

								El = El * dfdZl

							case "tanh":
								dfdZl = []
								if not FirstLayer:
									for a in A[LayerIndex]:
										dfdZl.append(1 - a**2)
								else:
									for a in P:
										dfdZl.append(1 - a**2)
							
								El = El * dfdZl

					#optimizing the biases
					El = np.clip(El, -5, 5)
					self.nn[LayerIndex][1] -= El * LearningRate

					#Calculating the error in weights and optimizing them
					for node,j_index in zip(self.nn[LayerIndex][0], range(len(self.nn[LayerIndex][0])) ):
						for w,Ak_index in zip(node, range(len(node)) ):
							
							# dCdWl[j,k] = Al-1[k] * El[j]
							dEdw = A[LayerIndex][Ak_index]
							dEdw *= El[j_index]

							dEdw = np.clip(dEdw, -3,3)

							self.nn[LayerIndex][0][j_index][Ak_index] -= dEdw * LearningRate
					LayerIndex -= 1
					FirstLayer = False



network = NeuralNetwork([1, 8, 16, 1], ["tanh", True, False, False])
#X is a list of 50 random inputs
X = [np.array([x]) for x in range(50)]
Y = [np.array([y**2]) for y in range (50)]


network.Optimize(X, Y, LearningRate = 0.001, epochs = 1500)

figure, graph = plt.subplots()
graph.plot([x[0] for x in X], [y[0] for y in Y], "b", label="Data")
graph.plot([x[0] for x in X], [network.Run(x)[0] for x in X], "r", label="Network Prediction")
graph.set_xlabel("Input")
graph.set_ylabel("Output")
plt.title("NN Prediction vs Data")
plt.show()


